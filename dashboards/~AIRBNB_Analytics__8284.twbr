          <datasource-dependencies datasource='federated.02z5b560t1qu2o17z52n81a1xp0l'>
            <column caption='Seasonality Index' datatype='real' name='[Calculation_0684768384688128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reviews])/(TOTAL(SUM([reviews]))/ 12)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Peak Month' datatype='boolean' name='[Calculation_0684768385392641]' role='dimension' type='nominal'>
