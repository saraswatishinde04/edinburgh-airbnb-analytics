      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Edinburgh&apos;s reviews peak in August, at 1.5x an average month</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='1Seasonality' path='/workbooks/AIRBNB_Analytics' revision='' />
      <table>
        <view>
          <datasources>
