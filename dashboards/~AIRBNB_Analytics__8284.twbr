    <worksheet name='2 Yearly'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Reviews fell 67% in 2020, and by 2025 were 2.8x their 2019 level</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='Sheet2' path='/workbooks/AIRBNB_Analytics' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='Listings+ (edinburgh_airbnb_tableau)' name='federated.02z5b560t1qu2o17z52n81a1xp0l' />
          </datasources>
          <datasource-dependencies datasource='federated.02z5b560t1qu2o17z52n81a1xp0l'>
            <column caption='COVID Year' datatype='boolean' name='[Calculation_0684768392712195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([review_month]) = 2020' />
            </column>
            <column caption='neighbourhood name (AvailabilityMonthly)' datatype='string' name='[neighbourhood_name (AvailabilityMonthly)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0684768392712195]' derivation='None' name='[none:Calculation_0684768392712195:nk]' pivot='key' type='nominal' />
            <column-instance column='[neighbourhood_name (AvailabilityMonthly)]' derivation='None' name='[none:neighbourhood_name (AvailabilityMonthly):nk]' pivot='key' type='nominal' />
            <column-instance column='[room_type (ReviewsMonthly)]' derivation='None' name='[none:room_type (ReviewsMonthly):nk]' pivot='key' type='nominal' />
            <column-instance column='[reviews]' derivation='Sum' name='[pcdf:sum:reviews:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='PctDiff'>
                <address>
                  <value>-1</value>
                </address>
