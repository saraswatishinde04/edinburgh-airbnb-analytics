      <aliases enabled='yes' />
      <column caption='Listings_1' datatype='integer' name='[Calculation_0483832973795328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([listing_id])' />
      </column>
      <column caption='Revenue Rank' datatype='integer' name='[Calculation_0483832974196737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(AVG([est_revenue_gbp_365]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Pct Superhost' datatype='real' name='[Calculation_0483832995364867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [superhost_label] = &quot;Superhost&quot; THEN [listing_id] END) / COUNTD([listing_id])' />
      </column>
      <column caption='Seasonality Index' datatype='real' name='[Calculation_0684768384688128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reviews])/(TOTAL(SUM([reviews]))/ 12)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Peak Month' datatype='boolean' name='[Calculation_0684768385392641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MONTH([review_month]) = 8' />
      </column>
      <column caption='COVID Year' datatype='boolean' name='[Calculation_0684768392712195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([review_month]) = 2020' />
      </column>
